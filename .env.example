# Mock server
MOCK_HOST=0.0.0.0
MOCK_PORT=8090

# Must match openapi-ptl ptl.ldap.aes.key (app-config.yml default)
LDAP_AES_KEY=SEQNUM01KG118K65MZ69NM8GMGE0XE5W

# Optional: path to fixture users (default: app/fixtures/ldap_users.yaml)
# LDAP_USERS_FILE=

# Must match openapi-mng-dev psso.aes.key (PSSO_AES_KEY env var in its run config)
PSSO_AES_KEY=PSSOMOCK25OVMC6CV13PC97OBEWX5FYE

# Optional: path to fixture users (default: app/fixtures/psso_users.yaml)
# PSSO_USERS_FILE=
